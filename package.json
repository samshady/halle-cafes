{
  "name": "halle-cafes",
  "version": "1.0.0",
  "description": "Mobile-first PWA cafe finder, opening hours tracker, and personal visit logger for Halle (Saale)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:responsive": "node --test tests/responsive_stars.test.mjs",
    "test:e2e": "node --test tests/full_feature_e2e.test.mjs",
    "build:data": "python3 scripts/build_dataset.py",
    "enrich:google": "python3 scripts/enrich_google.py",
    "cafe:list": "python3 scripts/manage_cafes.py list",
    "cafe:add": "python3 scripts/manage_cafes.py add",
    "cafe:update": "python3 scripts/manage_cafes.py update",
    "cafe:remove": "python3 scripts/manage_cafes.py remove",
    "cafe:validate": "python3 scripts/manage_cafes.py validate",
    "cafe:sync": "python3 scripts/manage_cafes.py sync",
    "serve": "npx serve -l 8080 ."
  },
  "keywords": [
    "halle",
    "cafes",
    "coffee",
    "pwa",
    "leaflet",
    "catppuccin",
    "osm",
    "github-pages"
  ],
  "author": "Sam",
  "license": "MIT"
}
